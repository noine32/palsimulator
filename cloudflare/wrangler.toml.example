name = "palbreeder-sync"
main = "worker.js"
compatibility_date = "2026-09-01"

# Create a Workers KV namespace and replace this ID.
[[kv_namespaces]]
binding = "PAL_DATA"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
ALLOWED_ORIGIN = "https://noine32.github.io"

# Never put PUSH_SECRET in this file.
# Set it with:
#   npx wrangler secret put PUSH_SECRET
